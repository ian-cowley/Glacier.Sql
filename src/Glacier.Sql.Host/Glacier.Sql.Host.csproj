<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.1.1</Version>
    <Description>Stdio-based JSON-RPC Model Context Protocol (MCP) server hosting the Glacier.Sql engine.</Description>
    <Authors>Glacier Contributors</Authors>
    <PackageTags>sql mcp model-context-protocol json-rpc database query-engine</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Glacier.Sql\Glacier.Sql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Glacier.Sql.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
